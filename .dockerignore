# ============================================================
# .dockerignore — files NOT copied into the Docker build context
# ============================================================
# Prevents secrets from leaking into image layers + reduces build size.
# ============================================================

# Dependencies
node_modules
**/node_modules

# Next.js build output
.next
out

# Build artifacts
dist
build

# Database files (mounted as volume at runtime)
db/
*.db
*.db-journal
db/backups/

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Env files — NEVER bake into image
.env
.env.local
.env.production
.env.*.local
.env.docker
.env.docker.*

# AI SDK config (contains API key — mount as volume instead)
.z-ai-config
.z-ai-config.*

# Secrets directory (contains API keys — mount as volume instead)
secrets/
secrets/**

# Backups
backups/
backups/**

# Logs
*.log
dev.log
server.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Docker files (not needed inside image)
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# Documentation
*.md
docs/
DEPLOY.md
worklog.md

# Tests
tests/
coverage/

# Examples / skills (not part of production app)
examples/
skills/
.zscripts/

# Download / upload temp dirs
download/
upload/

# Misc project artifacts
.tsbuildinfo
tool-results/

.env*
**/.env*
**/.z-ai-config*
*.tsbuildinfo

src_backup*/
